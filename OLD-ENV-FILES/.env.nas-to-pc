# Dolonia Digital Ocean - PC Supabase + NAS Website Configuration
# Your PC runs Supabase, your NAS runs the website

# ===========================================
# SUPABASE ON PC CONFIGURATION
# ===========================================
# Your NAS will connect to Supabase running on your PC

# PC IP Address (change if different)
VITE_SUPABASE_URL=http://10.15.20.207:54321

# Anon key from your local Supabase (safe for frontend use)
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# ===========================================
# ADDITIONAL CONFIG
# ===========================================
NODE_ENV=production

# ===========================================
# SETUP NOTES
# ===========================================
# 1. Keep Supabase running on your PC: supabase start
# 2. Ensure PC firewall allows port 54321
# 3. Deploy website to NAS with this .env
# 4. NAS website will connect to PC database
#
# Supabase Studio (on PC): http://127.0.0.1:54323
# Website (on NAS): http://your-nas-ip
# Database (on PC): postgresql://postgres:postgres@127.0.0.1:54322/postgres
