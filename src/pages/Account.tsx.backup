                        Total
                      </Badge>
                    </div>
                    <p className="text-sm font-semibold text-muted-foreground uppercase tracking-widest">Bandwidth</p>
                    <p className="text-2xl font-bold text-foreground mt-1">156 GB</p>
                    <Progress value={31} className="mt-3 h-2" />
