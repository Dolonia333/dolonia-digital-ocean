# Dolonia Digital Ocean - Environment Configuration
# Copy this file to .env and update with your actual Supabase credentials

# ===========================================
# SUPABASE CONFIGURATION (Required)
# ===========================================
# Get these from your Supabase project dashboard at https://supabase.com/dashboard

# Your Supabase project URL (format: https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon/public key (safe to expose in frontend)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# OPTIONAL CONFIGURATIONS
# ===========================================

# Custom API URL (only if you have Supabase Edge Functions)
# VITE_API_URL=https://your-project-id.supabase.co/functions/v1

# Application environment
NODE_ENV=production

# ===========================================
# INSTRUCTIONS
# ===========================================
# 1. Go to https://supabase.com/dashboard
# 2. Select your project (or create a new one)
# 3. Go to Settings > API
# 4. Copy the "Project URL" to VITE_SUPABASE_URL
# 5. Copy the "anon public" key to VITE_SUPABASE_ANON_KEY
# 6. Save this file as .env (remove .template from filename)
# 7. Deploy your container: docker-compose up -d

# ===========================================
# SECURITY NOTES
# ===========================================
# - The anon key is safe to expose in frontend code
# - Set up Row Level Security (RLS) in Supabase for data protection
# - Use service_role key only in backend/server-side code
# - Never commit the .env file to version control